# Copie este arquivo com o nome .env.local (na mesma pasta) e cole as suas chaves depois do =.
# O .env.local nunca vai para o git.

# Obrigatória: o Jev, a IA que decide qual objeção é. Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcional: a transcrição da OpenAI (~US$ 1 por hora de reunião). Vazia = só a transcrição grátis do Chrome.
# Crie em https://platform.openai.com/api-keys
OPENAI_API_KEY=
